# Copy this file to .env and fill in your key.
# Get a key at https://aistudio.google.com/apikey

VITE_GEMINI_API_KEY=

# Model id to call. Defaults to gemini-3.6-flash if unset
# (gemini-2.5-flash has been retired). Check the current list at
# https://ai.google.dev/gemini-api/docs/models and put its exact id here.
VITE_GEMINI_MODEL=gemini-3.6-flash
